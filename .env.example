# Contact form delivery.
# Without one of these configured, /api/contact returns an explicit
# "not configured" (503) response and the UI falls back to email / WhatsApp.
# No secrets are ever read on the client.
#
# Delivery priority: Resend is used when RESEND_API_KEY and CONTACT_FROM_EMAIL
# are both set. Otherwise CONTACT_WEBHOOK_URL is used.

# Send through Resend (https://resend.com). CONTACT_FROM_EMAIL must be a
# verified sender/domain in your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=query@mkgroupdigital.com

# Or forward the validated lead to a webhook / automation endpoint.
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Phase 2A — database and authentication
# ---------------------------------------------------------------------------
# All of the values below are created by the operator. Never commit real values.
#
# DATABASE_URL is the Neon PostgreSQL connection string (pooled endpoint).
# Used only by server-side code: Drizzle, Auth.js adapter and the health check.
DATABASE_URL=

# AUTH_SECRET signs session cookies and hashes magic-link tokens.
# Generate a unique value per environment, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# Required in production. The canonical origin used in magic-link callback
# URLs and invitation links. Production sign-in stays disabled without it, so
# links are never built from an attacker-controlled Host header. The live site
# must use https://www.seoindexer.in (no trailing slash).
AUTH_URL=https://www.seoindexer.in

# Verified sender for sign-in and invitation emails. Requires RESEND_API_KEY,
# or SMTP_HOST when EMAIL_TRANSPORT=smtp (local Mailpit).
AUTH_EMAIL_FROM=

# Email address of the first workspace owner. That address is allowed to sign
# in before any invitation exists and becomes the initial owner on first login.
# Remove or change only when ownership is already recorded in the database.
WORKSPACE_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Local development (copy into .env.local, which is git-ignored)
# ---------------------------------------------------------------------------
# DB_DRIVER is optional: loopback URLs select node-postgres automatically and
# every other host selects neon-http. Set it explicitly to avoid ambiguity.
# DB_DRIVER=node-postgres
# DATABASE_URL=postgresql://127.0.0.1:5432/mk_workforce_dev
# AUTH_URL=http://localhost:3000
# WORKSPACE_OWNER_EMAIL=owner@mk.local

# Mailpit catches local mail on SMTP 1025 (UI: http://localhost:8025).
# Leave RESEND_API_KEY unset locally so no real email can be sent.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# AUTH_EMAIL_FROM=MK AI Workforce <no-reply@mk.local>

# Disposable database for tests/last-owner-concurrency.test.mjs. The name must
# end in _test; destructive fixtures refuse any other database.
# PHASE2A_TEST_DATABASE_URL=postgresql://127.0.0.1:5432/mk_workforce_test

# Optional: shorten sessions to exercise expiry locally.
# SESSION_MAX_AGE_SECONDS=60

# ---------------------------------------------------------------------------
# Phase 2B — AI runtime
# ---------------------------------------------------------------------------
# Provider credentials are read only on the server and are never stored in the
# database or sent to the browser. Leave them unset and the workspace reports
# "AI execution is not configured" instead of pretending to run agents.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Queue connection (pg-boss requires a direct/unpooled TCP Postgres endpoint).
# Defaults to DATABASE_URL_UNPOOLED or DATABASE_URL if unset.
# QUEUE_DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# The worker health probe. Set AI_WORKER_HEALTH_URL to the Railway HTTPS
# /health endpoint in production, and share AI_WORKER_HEALTH_SECRET between
# Vercel and Railway to authenticate detailed queue/worker telemetry.
# AI_WORKER_HEALTH_URL=http://127.0.0.1:4319/health
# AI_WORKER_HEALTH_PORT=4319
# AI_WORKER_HEALTH_HOST=127.0.0.1
# AI_WORKER_HEALTH_TIMEOUT_MS=3000
# AI_WORKER_HEALTH_SECRET=


