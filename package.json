{
  "name": "mk-group-digital",
  "version": "1.0.0",
  "private": true,
  "description": "MK Group Digital — premium digital agency website",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "drizzle-kit check",
    "ai:worker": "node --env-file-if-exists=.env.local --import ./scripts/worker-register.mjs scripts/ai-worker.mjs",
    "ai:worker:prod": "node --import ./scripts/worker-register.mjs scripts/ai-worker.mjs",
    "test:integration": "node --env-file-if-exists=.env.local --import ./tests/register.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "formik": "^2.4.9",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "^6.6.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5"
  }
}
